@model SV22T1020433.Models.Common.IPagedResult
@{
    string jsHandler = ViewData["jsHandler"]?.ToString() ?? "paginationSearch";
    string formId = ViewData["formId"]?.ToString() ?? "formSearch";
}

@if (Model != null && Model.PageCount > 1)
{
    <div class="card-footer d-flex justify-content-between align-items-center">
        <small class="text-muted">
            Trang <strong>@Model.Page</strong> / @Model.PageCount (Tổng số <strong>@Model.RowCount.ToString("N0")</strong> dòng)
        </small>
        <ul class="pagination pagination-sm mb-0">
            @* Trang đầu *@
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" href="javascript:;" onclick="@(jsHandler)(arguments[0], document.getElementById('@formId'), 1)">
                    <i class="bi bi-chevron-double-left"></i>
                </a>
            </li>

            @* Danh sách các trang *@
            @foreach (var pageItem in Model.GetDisplayPages(3))
            {
                if (pageItem.Page == 0)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
                else
                {
                    <li class="page-item @(pageItem.IsCurrent ? "active" : "")">
                        @if (pageItem.IsCurrent)
                        {
                            <span class="page-link">@pageItem.Page</span>
                        }
                        else
                        {
                            <a class="page-link" href="javascript:;" onclick="@(jsHandler)(arguments[0], document.getElementById('@formId'), @pageItem.Page)">
                                @pageItem.Page
                            </a>
                        }
                    </li>
                }
            }

            @* Trang cuối *@
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link" href="javascript:;" onclick="@(jsHandler)(arguments[0], document.getElementById('@formId'), @Model.PageCount)">
                    <i class="bi bi-chevron-double-right"></i>
                </a>
            </li>
        </ul>
    </div>
}
