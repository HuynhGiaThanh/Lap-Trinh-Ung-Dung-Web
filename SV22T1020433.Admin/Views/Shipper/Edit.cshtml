@using SV22T1020433.Models.Partner
@model Shipper
@{
}
@section PageToolBar {
    <button type="submit" form="formEdit" class="btn btn-primary">
        <i class="bi bi-save"></i>
        Lưu dữ liệu
    </button>
    <a href="~/Shipper" class="btn btn-secondary ms-1">
        <i class="bi bi-arrow-left"></i>
        Quay lại
    </a>
}

<div class="row justify-content-center">
    <div class="col-12">
        <div class="card card-primary card-outline">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="bi bi-bicycle me-2"></i>
                    Thông tin người giao hàng
                </h5>
            </div>

            <div class="card-body">
                <form id="formEdit" action="~/Shipper/SaveData" method="post">
                    <input type="hidden" asp-for="ShipperID" />

                    <div class="mb-3">
                        <label class="form-label">Tên người giao hàng</label>
                        <input type="text"
                               class="form-control"
                               asp-for="ShipperName"
                               placeholder="Nhập tên người giao hàng" autofocus />
                        @Html.ValidationMessage(nameof(Model.ShipperName), "", new { @class = "text-danger" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Điện thoại</label>
                        <input type="tel"
                               class="form-control"
                               asp-for="Phone"
                               placeholder="Số điện thoại" />
                    </div>

                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                </form>
            </div>
        </div>
    </div>
</div>
