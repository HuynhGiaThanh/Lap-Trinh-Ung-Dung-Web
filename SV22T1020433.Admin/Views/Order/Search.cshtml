@using SV22T1020433.Models.Sales
@model SV22T1020433.Models.Common.PagedResult<OrderViewInfo>
@{
    Layout = null;
}

<div class="mb-2 text-muted">
    Danh sách này có <strong>@Model.RowCount</strong> đơn hàng
</div>

<div class="card">
    <div class="card-body p-1">
        <table class="table table-bordered table-hover mb-0">
            <thead class="table-secondary">
                <tr>
                    <th>Khách hàng</th>
                    <th>Ngày lập</th>
                    <th>Nhân viên</th>
                    <th>Ngày nhận</th>
                    <th>Người giao hàng</th>
                    <th>Trạng thái</th>
                    <th class="text-center" style="width:60px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.DataItems.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">Không có đơn hàng nào.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model.DataItems)
                    {
                        <tr>
                            <td>
                                <div>@item.CustomerName</div>
                                <div class="small text-muted">@item.DeliveryAddress (@item.DeliveryProvince)</div>
                            </td>
                            <td>@item.OrderTime.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@item.EmployeeName</td>
                            <td>@(item.AcceptTime?.ToString("dd/MM/yyyy HH:mm"))</td>
                            <td>@item.ShipperName</td>
                            <td class="text-center">
                                <span class="badge @(item.Status switch {
                                    OrderStatusEnum.New => "bg-info",
                                    OrderStatusEnum.Accepted => "bg-primary",
                                    OrderStatusEnum.Shipping => "bg-warning",
                                    OrderStatusEnum.Completed => "bg-success",
                                    OrderStatusEnum.Rejected => "bg-danger",
                                    OrderStatusEnum.Cancelled => "bg-secondary",
                                    _ => "bg-dark"
                                })">@item.StatusDescription</span>
                            </td>
                            <td class="text-center">
                                <a href="~/Order/Detail/@item.OrderID" class="btn btn-sm btn-info">
                                    <i class="bi bi-info-circle"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Pager", Model)
</div>
