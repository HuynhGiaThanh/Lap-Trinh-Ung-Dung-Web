@model IEnumerable<SV22T1020433.Models.Sales.OrderDetailViewInfo>
@{
    Layout = null;
    int stt = 0;
    decimal sumPrice = 0;
}
<div class="card card-outline card-success">
    <div class="card-header">
        <h5 class="mb-0">
            <i class="bi bi-cart"></i>
            Danh sách mặt hàng đã chọn
        </h5>
    </div>

    <div class="card-body">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-success">
                <tr>
                    <th class="text-center">#</th>
                    <th>Tên hàng</th>
                    <th class="text-center" style="width:100px">ĐVT</th>
                    <th class="text-center" style="width:80px">SL</th>
                    <th class="text-end" style="width:130px">Giá</th>
                    <th class="text-end" style="width:130px">Thành tiền</th>
                    <th style="width:80px"></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        stt += 1;
                        sumPrice += item.TotalPrice;
                        <tr>
                            <td class="text-center">@stt</td>
                            <td>@item.ProductName</td>
                            <td class="text-center">@item.Unit</td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-end">@item.SalePrice.ToString("N0")</td>
                            <td class="text-end fw-bold">@item.TotalPrice.ToString("N0")</td>
                            <td class="text-center">
                                <a href="javascript:;" class="text-danger" onclick="removeFromCart(@item.ProductID)">
                                    <i class="bi bi-x-circle"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">Giỏ hàng trống.</td>
                    </tr>
                }
            </tbody>
            @if (Model.Any())
            {
                <tfoot>
                    <tr>
                        <th colspan="5" class="text-end">Tổng cộng:</th>
                        <th class="text-end text-danger fs-5">@sumPrice.ToString("N0")</th>
                        <th></th>
                    </tr>
                </tfoot>
            }
        </table>

        @if (Model.Any())
        {
            <div class="text-end mt-3">
                <button class="btn btn-sm btn-outline-danger" onclick="clearCart()">
                    <i class="bi bi-trash"></i> Xóa giỏ hàng
                </button>
            </div>
        }
    </div>
</div>
