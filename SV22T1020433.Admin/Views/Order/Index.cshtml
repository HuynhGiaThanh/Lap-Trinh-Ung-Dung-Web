@model SV22T1020433.Models.Sales.OrderSearchInput
@{
    ViewBag.Title = "Quản lý đơn hàng";
}

@section PageToolBar {
    <a href="~/Order/Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> Lập đơn hàng mới
    </a>
}

<div class="card mb-3">
    <div class="card-body">
        <form id="formSearch" action="~/Order/Search" method="get" data-target="searchResult" onsubmit="paginationSearch(arguments[0], this, 1)">
            <div class="row">
                <div class="col-sm-2 mb-2">
                    <label>Trạng thái:</label>
                    <select class="form-select" asp-for="Status" asp-items="SelectListHelper.OrderStatus()" onchange="paginationSearch(null, document.getElementById('formSearch'), 1)">
                    </select>
                </div>
                <div class="col-sm-3 mb-2">
                    <label>Khoảng thời gian:</label>
                    <input type="text" asp-for="DateRange" class="form-control date-range-picker" onchange="paginationSearch(null, document.getElementById('formSearch'), 1)" />
                </div>
                <div class="col-sm-7 mb-2">
                    <label>Tìm kiếm:</label>
                    <div class="input-group">
                        <input type="hidden" asp-for="PageSize" />
                        <input type="text" asp-for="SearchValue" class="form-control" placeholder="Tên khách hàng hoặc tên người giao hàng..." autofocus />
                        <button class="btn btn-info d-flex align-items-center">
                            <i class="bi bi-search me-1"></i>
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<div id="searchResult"></div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            paginationSearch(null, document.getElementById("formSearch"), @Model.Page);
        });
    </script>
}
