@using SV22T1020433.Admin
@{
    Layout = null;
    int orderId = ViewContext.RouteData.Values["id"] != null ? int.Parse(ViewContext.RouteData.Values["id"]!.ToString()!) : 0;
}
<div class="modal-header text-bg-primary">
    <strong class="modal-title">Chọn người giao hàng</strong>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<form method="post" action="~/Order/Shipping/@orderId">
    <div class="modal-body">
        <div class="row">
            <div class="col-12">
                <label class="form-label">Người giao hàng</label>
                <select class="form-select" name="shipperID" asp-items="await SelectListHelper.Shippers()">
                </select>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-bicycle"></i> Giao hàng
        </button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
    </div>
</form>
