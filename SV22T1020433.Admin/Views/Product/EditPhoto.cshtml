@using SV22T1020433.Models.Catalog
@model ProductPhoto
@{
}
@section PageToolBar {
    <button type="submit" form="formEditPhoto" class="btn btn-primary">
        <i class="bi bi-save me-1"></i>
        Lưu dữ liệu
    </button>
    <a href="~/Product/Edit/@Model.ProductID" class="btn btn-secondary ms-1">
        <i class="bi bi-arrow-left"></i>
        Quay lại
    </a>
}

<div class="row justify-content-center">
    <div class="col-12">
        <div class="card card-info card-outline">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="bi bi-images me-2"></i>
                    Thông tin ảnh của mặt hàng
                </h5>
            </div>

            <div class="card-body">
                <form id="formEditPhoto" action="~/Product/SavePhoto" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="ProductID" />
                    <input type="hidden" asp-for="PhotoID" />
                    <input type="hidden" asp-for="Photo" />

                    <div class="mb-3">
                        <label class="form-label">Chọn file ảnh</label>
                        <input type="file" name="uploadPhoto" class="form-control" accept="image/*"
                               data-img-preview="imgPreview" onchange="previewImage(this)" />
                        @Html.ValidationMessage(nameof(Model.Photo), "", new { @class = "text-danger" })
                    </div>

                    <div class="mb-3">
                        <img id="imgPreview" src="~/images/products/@(string.IsNullOrWhiteSpace(Model.Photo) ? "noproduct.png" : Model.Photo)"
                             class="img-thumbnail" style="max-height: 200px;" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Mô tả / Tiêu đề</label>
                        <input type="text" asp-for="Description" class="form-control" placeholder="Mô tả ảnh" autofocus />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Thứ tự hiển thị</label>
                        <input type="number" asp-for="DisplayOrder" class="form-control" />
                        @Html.ValidationMessage(nameof(Model.DisplayOrder), "", new { @class = "text-danger" })
                    </div>

                    <div class="mb-3 mt-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="IsHidden" id="IsHidden" />
                            <label class="form-check-label" for="IsHidden">Ẩn ảnh này (không hiển thị cho khách hàng)</label>
                        </div>
                    </div>

                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                </form>
            </div>
        </div>
    </div>
</div>
