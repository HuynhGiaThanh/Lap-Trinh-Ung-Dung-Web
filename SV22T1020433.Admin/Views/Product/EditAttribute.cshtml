@using SV22T1020433.Models.Catalog
@model ProductAttribute
@{
}
@section PageToolBar {
    <button type="submit" form="formEditAttribute" class="btn btn-primary">
        <i class="bi bi-save me-1"></i>
        Lưu dữ liệu
    </button>
    <a href="~/Product/Edit/@Model.ProductID" class="btn btn-secondary ms-1">
        <i class="bi bi-arrow-left"></i>
        Quay lại
    </a>
}

<div class="row justify-content-center">
    <div class="col-12">
        <div class="card card-success card-outline">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="bi bi-list-stars me-2"></i>
                    Thông tin thuộc tính của mặt hàng
                </h5>
            </div>

            <div class="card-body">
                <form id="formEditAttribute" action="~/Product/SaveAttribute" method="post">
                    <input type="hidden" asp-for="ProductID" />
                    <input type="hidden" asp-for="AttributeID" />

                    <div class="mb-3">
                        <label class="form-label">Tên thuộc tính</label>
                        <input type="text" asp-for="AttributeName" class="form-control" placeholder="Tên thuộc tính" autofocus />
                        @Html.ValidationMessage(nameof(Model.AttributeName), "", new { @class = "text-danger" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Giá trị</label>
                        <input type="text" asp-for="AttributeValue" class="form-control" placeholder="Giá trị thuộc tính" />
                        @Html.ValidationMessage(nameof(Model.AttributeValue), "", new { @class = "text-danger" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Thứ tự hiển thị</label>
                        <input type="number" asp-for="DisplayOrder" class="form-control" />
                        @Html.ValidationMessage(nameof(Model.DisplayOrder), "", new { @class = "text-danger" })
                    </div>

                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                </form>
            </div>
        </div>
    </div>
</div>
