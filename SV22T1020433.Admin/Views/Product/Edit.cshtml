@using SV22T1020433.Models.Catalog
@model Product
@{
}

@section PageToolBar {
    <button type="submit" form="formEdit" class="btn btn-primary">
        <i class="bi bi-save me-1"></i>
        Lưu dữ liệu
    </button>
    <a href="~/Product" class="btn btn-secondary ms-1">
        <i class="bi bi-arrow-left"></i>
        Quay lại
    </a>
}

<div class="row justify-content-center">
    <div class="col-12">
        <div class="card card-primary card-outline">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="bi bi-box-seam me-2"></i>
                    Thông tin mặt hàng
                </h5>
            </div>

            <div class="card-body">
                <form id="formEdit" action="~/Product/SaveData" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="ProductID" />
                    <input type="hidden" asp-for="Photo" />

                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">Tên mặt hàng</label>
                        <div class="col-sm-10">
                            <input type="text" asp-for="ProductName" class="form-control" placeholder="Tên mặt hàng" autofocus />
                            @Html.ValidationMessage(nameof(Model.ProductName), "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">Loại hàng</label>
                        <div class="col-sm-4">
                            <select class="form-select" asp-for="CategoryID" asp-items="await SelectListHelper.Categories()">
                            </select>
                            @Html.ValidationMessage(nameof(Model.CategoryID), "", new { @class = "text-danger" })
                        </div>
                        <label class="col-sm-2 col-form-label text-end">Nhà cung cấp</label>
                        <div class="col-sm-4">
                            <select class="form-select" asp-for="SupplierID" asp-items="await SelectListHelper.Suppliers()">
                            </select>
                            @Html.ValidationMessage(nameof(Model.SupplierID), "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">Đơn vị tính</label>
                        <div class="col-sm-4">
                            <input type="text" asp-for="Unit" class="form-control" placeholder="Đơn vị tính" />
                            @Html.ValidationMessage(nameof(Model.Unit), "", new { @class = "text-danger" })
                        </div>
                        <label class="col-sm-2 col-form-label text-end">Giá hàng</label>
                        <div class="col-sm-4">
                            <input type="text" asp-for="Price" class="form-control" placeholder="Giá hàng" />
                            @Html.ValidationMessage(nameof(Model.Price), "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">Trạng thái</label>
                        <div class="col-sm-10 mt-2">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="IsSelling" id="IsSelling" />
                                <label class="form-check-label" for="IsSelling">Đang được bán</label>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">Mô tả</label>
                        <div class="col-sm-10">
                            <textarea class="form-control" asp-for="ProductDescription" rows="4" placeholder="Mô tả sản phẩm"></textarea>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">Ảnh minh họa</label>
                        <div class="col-sm-10">
                            <input type="file" name="uploadPhoto" class="form-control" accept="image/*"
                                   data-img-preview="imgPreview" onchange="previewImage(this)" />
                            <div class="mt-2">
                                <img id="imgPreview" src="~/images/products/@(string.IsNullOrWhiteSpace(Model.Photo) ? "noproduct.png" : Model.Photo)"
                                     class="img-thumbnail" style="max-height: 150px;" />
                            </div>
                        </div>
                    </div>

                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                </form>
            </div>
        </div>

        @if (Model.ProductID > 0)
        {
            @* --- DANH SÁCH ẢNH THƯ VIỆN --- *@
            <div class="card mt-4 border-info">
                <div class="card-header bg-info bg-opacity-10 d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0 text-info">
                        <i class="bi bi-images me-2"></i> Thư viện ảnh sản phẩm
                    </h5>
                    <a href="~/Product/EditPhoto/@Model.ProductID?photoId=0" class="btn btn-sm btn-info">
                        <i class="bi bi-plus-circle me-1"></i> Bổ sung ảnh
                    </a>
                </div>
                <div class="card-body p-0">
                    <table class="table table-bordered table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 120px;">Ảnh</th>
                                <th>Mô tả / Tiêu đề</th>
                                <th style="width: 100px;">Thứ tự</th>
                                <th style="width: 100px;">Trạng thái</th>
                                <th style="width: 100px;" class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var photo in (IEnumerable<ProductPhoto>)ViewBag.ProductPhotos)
                            {
                                <tr>
                                    <td class="text-center">
                                        <img src="~/images/products/@photo.Photo" class="img-thumbnail" style="height: 60px;" />
                                    </td>
                                    <td>@photo.Description</td>
                                    <td>@photo.DisplayOrder</td>
                                    <td class="text-center">@(photo.IsHidden ? "Ẩn" : "Hiện")</td>
                                    <td class="text-center">
                                        <a href="~/Product/EditPhoto/@Model.ProductID?photoId=@photo.PhotoID" class="btn btn-sm btn-primary">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a href="~/Product/DeletePhoto/@Model.ProductID?photoId=@photo.PhotoID" class="btn btn-sm btn-danger">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @* --- DANH SÁCH THUỘC TÍNH --- *@
            <div class="card mt-4 border-success">
                <div class="card-header bg-success bg-opacity-10 d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0 text-success">
                        <i class="bi bi-list-stars me-2"></i> Thuộc tính sản phẩm
                    </h5>
                    <a href="~/Product/EditAttribute/@Model.ProductID?attributeId=0" class="btn btn-sm btn-success">
                        <i class="bi bi-plus-circle me-1"></i> Bổ sung thuộc tính
                    </a>
                </div>
                <div class="card-body p-0">
                    <table class="table table-bordered table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Tên thuộc tính</th>
                                <th>Giá trị</th>
                                <th style="width: 100px;">Thứ tự</th>
                                <th style="width: 100px;" class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var attr in (IEnumerable<ProductAttribute>)ViewBag.ProductAttributes)
                            {
                                <tr>
                                    <td class="fw-bold">@attr.AttributeName</td>
                                    <td>@attr.AttributeValue</td>
                                    <td>@attr.DisplayOrder</td>
                                    <td class="text-center">
                                        <a href="~/Product/EditAttribute/@Model.ProductID?attributeId=@attr.AttributeID" class="btn btn-sm btn-primary">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a href="~/Product/DeleteAttribute/@Model.ProductID?attributeId=@attr.AttributeID" class="btn btn-sm btn-danger">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>
