@model SV22T1020433.Models.Common.IPagedResult
@using Microsoft.AspNetCore.WebUtilities
@{
    string actionName = ViewData["actionName"]?.ToString() ?? "Index";
    string controllerName = ViewData["controllerName"]?.ToString() ?? ViewContext.RouteData.Values["controller"]?.ToString();
    var queryParameters = ViewData["queryParameters"] as Dictionary<string, string> ?? new Dictionary<string, string>();

    string GetPageUrl(int page)
    {
        var parameters = new Dictionary<string, string>(queryParameters);
        parameters["page"] = page.ToString();
        return Url.Action(actionName, controllerName, parameters) ?? "#";
    }
}

@if (Model != null && Model.PageCount > 1)
{
    <nav>
        <ul class="pagination justify-content-center mb-0">
            @* Trang đầu *@
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" href="@GetPageUrl(1)" title="Trang đầu">
                    <i class="bi bi-chevron-double-left"></i>
                </a>
            </li>

            @* Danh sách các trang *@
            @foreach (var pageItem in Model.GetDisplayPages(3))
            {
                if (pageItem.Page == 0)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
                else
                {
                    <li class="page-item @(pageItem.IsCurrent ? "active" : "")">
                        @if (pageItem.IsCurrent)
                        {
                            <span class="page-link">@pageItem.Page</span>
                        }
                        else
                        {
                            <a class="page-link" href="@GetPageUrl(pageItem.Page)">
                                @pageItem.Page
                            </a>
                        }
                    </li>
                }
            }

            @* Trang cuối *@
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link" href="@GetPageUrl(Model.PageCount)" title="Trang cuối">
                    <i class="bi bi-chevron-double-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}
