@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 text-uppercase fw-bold text-primary text-center">Đổi mật khẩu</h5>
            </div>
            <div class="card-body p-4">
                <form asp-controller="Account" asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-bold">Mật khẩu cũ</label>
                        <input type="password" name="oldPassword" class="form-control" required />
                        @Html.ValidationMessage("oldPassword", "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Mật khẩu mới</label>
                        <input type="password" name="newPassword" class="form-control" required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Xác nhận mật khẩu mới</label>
                        <input type="password" name="confirmPassword" class="form-control" required />
                        @Html.ValidationMessage("confirmPassword", "", new { @class = "text-danger small" })
                    </div>

                    <div class="d-grid gap-2 mb-3">
                        <button type="submit" class="btn btn-primary btn-lg">CẬP NHẬT MẬT KHẨU</button>
                    </div>

                    <div class="text-danger text-center mb-3 small">
                        @Html.ValidationSummary(true)
                    </div>

                    <div class="text-center">
                        <a asp-action="Profile" class="text-decoration-none">Quay lại trang cá nhân</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
