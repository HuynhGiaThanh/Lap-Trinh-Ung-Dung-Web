@model SV22T1020433.Models.Common.PagedResult<OrderViewInfo>
@{
    ViewData["Title"] = "Lịch sử mua hàng";
}

<div class="card shadow-sm mb-5">
    <div class="card-header bg-white py-3">
        <h4 class="mb-0 fw-bold text-uppercase"><i class="bi bi-clock-history me-2 text-primary"></i>Lịch sử mua hàng</h4>
    </div>
    <div class="card-body p-0">
        @if (!Model.DataItems.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
                <p class="text-muted">Bạn chưa có đơn hàng nào.</p>
                <a asp-controller="Product" asp-action="Index" class="btn btn-primary mt-3 text-uppercase">Bắt đầu mua sắm</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr class="small text-uppercase fw-bold text-muted">
                            <th class="ps-4">Mã ĐH</th>
                            <th>Ngày đặt</th>
                            <th>Địa chỉ giao hàng</th>
                            <th class="text-end">Tổng tiền</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-center pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.DataItems)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">#@item.OrderID</td>
                                <td>@item.OrderTime.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <div class="small text-truncate" style="max-width: 250px;" title="@item.DeliveryAddress">@item.DeliveryAddress</div>
                                    <div class="small text-muted">@item.DeliveryProvince</div>
                                </td>
                                <td class="text-end fw-bold text-danger">@item.SumOfPrice.ToString("N0") VNĐ</td>
                                <td class="text-center">
                                    @{
                                        string badgeClass = item.Status switch
                                        {
                                            OrderStatusEnum.New => "bg-info",
                                            OrderStatusEnum.Accepted => "bg-primary",
                                            OrderStatusEnum.Shipping => "bg-warning",
                                            OrderStatusEnum.Completed => "bg-success",
                                            OrderStatusEnum.Cancelled => "bg-secondary",
                                            OrderStatusEnum.Rejected => "bg-danger",
                                            _ => "bg-dark"
                                        };
                                    }
                                    <span class="badge @badgeClass">@item.StatusDescription</span>
                                </td>
                                <td class="text-center pe-4">
                                    <a href="~/Order/Detail/@item.OrderID" class="btn btn-outline-primary btn-sm">
                                        Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    
    <div class="card-footer bg-white py-3">
        @{
            var queryParams = new Dictionary<string, string>
            {
                { "searchValue", ViewBag.CurrentSearch?.ToString() ?? "" }
            };
        }
        @await Html.PartialAsync("_Pager", Model, new ViewDataDictionary(ViewData) { { "queryParameters", queryParams }, { "actionName", "History" } })
    </div>
</div>
