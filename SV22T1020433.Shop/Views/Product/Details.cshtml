@model SV22T1020433.Models.Catalog.Product
@{
    ViewData["Title"] = Model.ProductName;
    var photos = ViewBag.Photos as List<ProductPhoto> ?? new List<ProductPhoto>();
    var attributes = ViewBag.Attributes as List<ProductAttribute> ?? new List<ProductAttribute>();
    var relatedProducts = ViewBag.RelatedProducts as List<Product> ?? new List<Product>();
}

<div class="row">
    <div class="col-md-6 mb-4">
        <div class="card shadow-sm">
            <div class="p-2">
                <img id="mainImage" src="~/images/products/@(string.IsNullOrWhiteSpace(Model.Photo) ? "noproduct.png" : Model.Photo)" 
                     class="img-fluid rounded w-100" alt="@Model.ProductName" style="max-height: 500px; object-fit: contain;">
            </div>
            @if (photos.Any())
            {
                <div class="card-footer bg-white">
                    <div class="row g-2">
                        <div class="col-3">
                            <img src="~/images/products/@(string.IsNullOrWhiteSpace(Model.Photo) ? "noproduct.png" : Model.Photo)" 
                                 class="img-thumbnail cursor-pointer" onclick="changeImage(this.src)" style="height: 80px; width: 100%; object-fit: cover;">
                        </div>
                        @foreach (var p in photos)
                        {
                            <div class="col-3">
                                <img src="~/images/products/@p.Photo" 
                                     class="img-thumbnail cursor-pointer" onclick="changeImage(this.src)" style="height: 80px; width: 100%; object-fit: cover;">
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="col-md-6 mb-4">
        <div class="ps-md-4">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Sản phẩm</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.ProductName</li>
                </ol>
            </nav>

            <h1 class="fw-bold mb-3">@Model.ProductName</h1>
            
            <div class="d-flex align-items-center mb-3">
                <span class="text-danger fw-bold fs-2 me-3">@Model.Price.ToString("N0") VNĐ</span>
                @if (Model.IsSelling)
                {
                    <span class="badge bg-success">Đang kinh doanh</span>
                }
            </div>

            <div class="mb-4">
                <p class="text-muted">@Model.ProductDescription</p>
            </div>

            <div class="card bg-light border-0 mb-4">
                <div class="card-body">
                    <div class="row small">
                        <div class="col-4 fw-bold text-muted text-uppercase">Đơn vị tính:</div>
                        <div class="col-8">@Model.Unit</div>
                    </div>
                </div>
            </div>

            <form action="~/Cart/Add" method="post" class="mb-5">
                <input type="hidden" name="id" value="@Model.ProductID" />
                <div class="row g-3 align-items-center">
                    <div class="col-auto">
                        <label class="fw-bold">Số lượng:</label>
                    </div>
                    <div class="col-auto" style="width: 100px;">
                        <input type="number" name="quantity" value="1" min="1" class="form-control" />
                    </div>
                    <div class="col-auto flex-grow-1">
                        <button type="submit" class="btn btn-primary btn-lg w-100">
                            <i class="bi bi-cart-plus me-2"></i>THÊM VÀO GIỎ HÀNG
                        </button>
                    </div>
                </div>
            </form>

            @if (attributes.Any())
            {
                <div class="mt-5">
                    <h5 class="fw-bold mb-3 text-uppercase border-bottom pb-2">Thông số kỹ thuật</h5>
                    <table class="table table-striped small">
                        <tbody>
                            @foreach (var attr in attributes)
                            {
                                <tr>
                                    <th style="width: 30%">@attr.AttributeName</th>
                                    <td>@attr.AttributeValue</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@if (relatedProducts.Any())
{
    <div class="mt-5">
        <h4 class="fw-bold mb-4 text-uppercase text-center">Sản phẩm liên quan</h4>
        <div class="row row-cols-1 row-cols-md-4 g-4">
            @foreach (var item in relatedProducts)
            {
                if (item.ProductID != Model.ProductID)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm border-0">
                            <a href="~/Product/Details/@item.ProductID" class="text-decoration-none text-dark">
                                <img src="~/images/products/@(string.IsNullOrWhiteSpace(item.Photo) ? "noproduct.png" : item.Photo)" 
                                     class="card-img-top" alt="@item.ProductName" style="height: 150px; object-fit: cover;">
                                <div class="card-body p-3 text-center">
                                    <h6 class="card-title text-truncate small">@item.ProductName</h6>
                                    <p class="card-text text-danger fw-bold small mb-0">@item.Price.ToString("N0") VNĐ</p>
                                </div>
                            </a>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
}

@section Scripts {
    <script>
        function changeImage(src) {
            document.getElementById('mainImage').src = src;
        }
    </script>
}

<style>
    .cursor-pointer { cursor: pointer; }
    .breadcrumb-item a { text-decoration: none; }
</style>
